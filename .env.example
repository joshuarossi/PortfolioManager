# Server
PORT=3001
DATABASE_URL=./data/portfolio.db
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string!!

# Optional: OpenAI for direct API use / pi assistant
OPENAI_API_KEY=

# Optional: pi assistant model (provider/id), e.g. anthropic/claude-sonnet-4-20250514
PI_MODEL=

# Optional: Additional pi assistant providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: Max USD notional per trade order (default 25000)
TRADE_MAX_USD_PER_ORDER=25000
